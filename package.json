{
  "name": "@yedincoder/ngbuildframework",
  "version": "1.0.1",
  "description": "NgBuild Framework - One Framework. Web, API & Mobile.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core-entry.d.ts",
      "import": "./dist/core-entry.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./api": {
      "types": "./dist/api-entry.d.ts",
      "import": "./dist/api-entry.js"
    },
    "./mobile": {
      "types": "./dist/mobile-entry.d.ts",
      "import": "./dist/mobile-entry.js"
    }
  },
  "files": ["dist/", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev:framework": "ngbuild dev .",
    "test": "npm run test:all",
    "test:all": "npm run test:api && npm run test:mobile && npm run test:unified && npm run test:package && npm run test:cli && npm run test:starter && npm run test:build",
    "test:api": "tsx src/api/final-test.ts",
    "test:mobile": "tsx src/mobile/final-test.ts",
    "test:unified": "tsx src/unified-test.ts",
    "test:package": "node src/package-test.mjs",
    "test:cli": "node src/cli-test.mjs",
    "test:starter": "node src/starter-test.mjs",
    "test:build": "node src/build-integration-test.mjs"
  },
  "keywords": [
    "ngbuild",
    "framework",
    "javascript",
    "typescript",
    "web",
    "api",
    "mobile",
    "modular"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yedincoder/ngbuildframework.git"
  },
  "homepage": "https://github.com/yedincoder/ngbuildframework#readme",
  "bugs": {
    "url": "https://github.com/yedincoder/ngbuildframework/issues"
  },
  "author": "YedinCoder",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@yedincoder/ngbuild": "^1.0.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}